// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g r": "editor::FindAllReferences"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "g r r": "editor::FindAllReferences"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g i": "editor::GoToImplementation"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "g r i": "editor::GoToImplementation"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-n": "workspace::NewFile"
    }
  },
  {
    "context": "Welcome",
    "unbind": {
      "ctrl-n": "workspace::NewFile"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-p": "file_finder::Toggle"
    }
  },
  {
    "context": "Workspace && !Terminal && !Menu",
    "bindings": {
      "ctrl-p": "file_finder::Toggle"
    }
  },
  {
    "context": "!Terminal",
    "bindings": {
      "ctrl-e": "workspace::ToggleLeftDock"
    }
  },
  // send directly to terminal
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-t": ["terminal::SendKeystroke", "ctrl-t"],
      "ctrl-s": ["terminal::SendKeystroke", "ctrl-s"]
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-t": "tab_switcher::Toggle"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-tab": "tab_switcher::Toggle"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g t": "project_symbols::Toggle"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-t": "project_symbols::Toggle"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "unbind": {
      "g t": "vim::GoToTab"
    }
  }
]
